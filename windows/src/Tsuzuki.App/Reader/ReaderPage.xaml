<UserControl
    x:Class="Tsuzuki.App.Reader.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tsuzuki.App.Controls"
    IsTabStop="True">
  <Grid x:Name="Root" Background="{ThemeResource TzReaderBackground}">
    <ScrollView x:Name="PagedScroll" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="6"
                HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto"
                ContentOrientation="None">
      <Grid x:Name="PagedContent">
        <Grid x:Name="Spread" HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image x:Name="PageLeft" Stretch="Fill" />
          <Image x:Name="PageRight" Grid.Column="1" Stretch="Fill" />
          <Border x:Name="Spine" Grid.ColumnSpan="2" Width="44" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#2E000000" Offset="0.5" />
                <GradientStop Color="#00000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>
      </Grid>
    </ScrollView>

    <ScrollView x:Name="StripScroll" Visibility="Collapsed" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="4"
                HorizontalScrollMode="Auto" VerticalScrollMode="Enabled"
                HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
      <ItemsRepeater x:Name="Strip" HorizontalAlignment="Center">
        <ItemsRepeater.Layout>
          <StackLayout Spacing="0" />
        </ItemsRepeater.Layout>
      </ItemsRepeater>
    </ScrollView>

    <ProgressRing x:Name="LoadingRing" Width="36" Height="36" IsActive="False" Foreground="White" />

    <StackPanel x:Name="Message" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420">
      <TextBlock x:Name="MessageTitle" Style="{StaticResource TzTitle}" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
      <TextBlock x:Name="MessageBody" Style="{StaticResource TzBody}" Foreground="#B0FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
      <Button x:Name="MessageAction" Style="{StaticResource TzAccentButton}" HorizontalAlignment="Center" Content="Try again" />
    </StackPanel>

    <Grid x:Name="EndCard" Visibility="Collapsed">
      <Grid.Background>
        <AcrylicBrush TintColor="#000000" TintOpacity="0.62" TintLuminosityOpacity="0.55" FallbackColor="#F0101114" />
      </Grid.Background>
      <StackPanel x:Name="EndColumn" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" Margin="32,72,32,96" Spacing="0">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="22" Height="22" CornerRadius="11" Background="{ThemeResource AccentFillColorDefaultBrush}">
            <FontIcon Glyph="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
          <TextBlock x:Name="EndFinished" FontSize="14" FontWeight="SemiBold" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="EndSeries" FontSize="12" Foreground="#8CFFFFFF" Margin="32,2,0,0" TextTrimming="CharacterEllipsis" MaxLines="1" />

        <Grid x:Name="EndNextCard" Margin="0,28,0,0" Padding="18" CornerRadius="12" ColumnSpacing="20" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="92" Height="138" CornerRadius="6" Background="#1AFFFFFF">
            <controls:CoverImage x:Name="EndCover" DecodeWidth="200" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="UP NEXT" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EndTitle" FontSize="30" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="EndChapterName" FontSize="15" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock x:Name="EndBody" FontSize="12" Foreground="#8CFFFFFF" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxLines="1" />
          </StackPanel>
        </Grid>

        <StackPanel x:Name="EndCaughtUp" Visibility="Collapsed" Margin="0,28,0,0" Spacing="6">
          <TextBlock Text="You're caught up" FontSize="30" FontWeight="SemiBold" Foreground="White" />
          <TextBlock x:Name="EndCaughtUpBody" FontSize="14" Foreground="#B3FFFFFF" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,24,0,0">
          <Button x:Name="EndNext" Style="{ThemeResource AccentButtonStyle}" Height="44" Padding="18,0,10,0" CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE768;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
              <TextBlock x:Name="EndNextText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border CornerRadius="4" Padding="6,1,6,2" BorderThickness="1" BorderBrush="#40000000" Background="#1A000000" VerticalAlignment="Center">
                <TextBlock Text="Enter" FontSize="11" />
              </Border>
            </StackPanel>
          </Button>
          <Button x:Name="EndRefresh" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" Height="44" Padding="18,0" CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE72C;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
              <TextBlock x:Name="EndRefreshText" Text="Check for new chapters" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="EndClose" Height="44" Padding="18,0" CornerRadius="8" Background="#1FFFFFFF" Foreground="White" BorderBrush="#24FFFFFF" Content="Back to details" FontSize="15" />
        </StackPanel>

        <Grid Margin="0,28,0,0" RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ProgressBar x:Name="EndProgress" Height="3" Minimum="0" Maximum="1" CornerRadius="1.5" Background="#26FFFFFF" />
          <Grid Grid.Row="1">
            <TextBlock x:Name="EndProgressText" FontSize="12" Foreground="#8CFFFFFF" />
            <TextBlock x:Name="EndHint" FontSize="12" Foreground="#73FFFFFF" HorizontalAlignment="Right" />
          </Grid>
        </Grid>
      </StackPanel>
    </Grid>

    <Border x:Name="HintBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,96" Padding="18,9" CornerRadius="19" Visibility="Collapsed"
            Background="{ThemeResource TzReaderChrome}" BorderBrush="#20FFFFFF" BorderThickness="1">
      <TextBlock x:Name="HintText" Foreground="#C8FFFFFF" FontSize="12" />
    </Border>

    <Border x:Name="GoToBox" Visibility="Collapsed" RequestedTheme="Dark" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,76,0,0" Padding="16,10" CornerRadius="18"
            Background="{ThemeResource TzReaderChrome}" BorderBrush="#24FFFFFF" BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Go to page" Foreground="#C8FFFFFF" FontSize="13" VerticalAlignment="Center" />
        <TextBox x:Name="GoToInput" Width="76" InputScope="Number" VerticalAlignment="Center" />
        <TextBlock x:Name="GoToTotal" Foreground="#A8FFFFFF" FontSize="13" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border x:Name="Pill" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,10" CornerRadius="20"
            Background="{ThemeResource TzReaderChrome}" BorderBrush="#24FFFFFF" BorderThickness="1">
      <TextBlock x:Name="PillText" Foreground="White" FontSize="14" FontWeight="SemiBold" />
    </Border>

    <Grid x:Name="ShortcutLayer" Visibility="Collapsed" Background="#99000000" RequestedTheme="Dark">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20" CornerRadius="20" MinWidth="380" MaxWidth="560"
              Background="{ThemeResource TzReaderChrome}" BorderBrush="#24FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock x:Name="ShortcutTitle" Style="{StaticResource TzTitle}" Foreground="White" />
          <Grid x:Name="ShortcutRows" ColumnSpacing="20" RowSpacing="7">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
          </Grid>
          <TextBlock Text="Esc or ? to close" Style="{StaticResource TzCaption}" Foreground="#99FFFFFF" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
