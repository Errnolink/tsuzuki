<nav:TzPage
    x:Class="Tsuzuki.App.Pages.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:Tsuzuki.App.Navigation">
  <GridView x:Name="TileGrid" SelectionMode="None" Padding="40,74,40,48">
    <GridView.Header>
      <StackPanel>
        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="TitleBlock">
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
              <TextBlock Text="Browse" Style="{StaticResource TzLargeTitle}" />
              <DropDownButton x:Name="SourcePicker" VerticalAlignment="Center" CornerRadius="16" Padding="14,5,10,5" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="Summary" Style="{StaticResource TzCaption}" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <AutoSuggestBox x:Name="SourceSearch" Width="300" VerticalAlignment="Center">
              <AutoSuggestBox.QueryIcon>
                <FontIcon FontFamily="{StaticResource TzIconFont}" Glyph="&#xE151;" FontSize="14" />
              </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
            <Button x:Name="FiltersButton" VerticalAlignment="Stretch" Padding="12,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="{StaticResource TzIconFont}" Glyph="&#xE460;" FontSize="14" />
                <TextBlock Text="Filters" VerticalAlignment="Center" />
                <InfoBadge x:Name="FilterBadge" Visibility="Collapsed" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <StackPanel x:Name="Modes" Orientation="Horizontal" Spacing="8" Margin="0,22,0,22" />
      </StackPanel>
    </GridView.Header>
    <GridView.Footer>
      <StackPanel>
        <ProgressRing x:Name="LoadingRing" IsActive="False" Width="28" Height="28" Margin="0,28,0,0" />
        <StackPanel x:Name="Message" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,60,0,0" Spacing="10" MaxWidth="420">
          <TextBlock x:Name="MessageTitle" Style="{StaticResource TzTitle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock x:Name="MessageBody" Style="{StaticResource TzSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          <Button x:Name="RetryButton" Style="{StaticResource TzSoftButton}" Content="Try again" HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </GridView.Footer>
  </GridView>
</nav:TzPage>
