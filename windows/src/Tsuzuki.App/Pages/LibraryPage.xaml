<UserControl
    x:Class="Tsuzuki.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <GridView x:Name="TileGrid" SelectionMode="None" Padding="40,74,40,48">
    <GridView.Header>
      <StackPanel>
        <StackPanel x:Name="TitleBlock">
          <TextBlock Text="LIBRARY · 本棚" Style="{StaticResource TzKicker}" />
          <TextBlock Text="Library" Style="{StaticResource TzLargeTitle}" Margin="0,2,0,0" />
          <TextBlock x:Name="Summary" Style="{StaticResource TzCaption}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel x:Name="Skeleton" Margin="0,30,0,0">
          <TextBlock Text="CONTINUE · 続きを読む" Style="{StaticResource TzKicker}" />
          <StackPanel x:Name="GhostContinue" Orientation="Horizontal" Spacing="16" Padding="8,14,40,18" />
          <StackPanel x:Name="GhostTiles" />
        </StackPanel>

        <StackPanel x:Name="ContinueSection" Margin="0,30,0,0" Visibility="Collapsed">
          <TextBlock Text="CONTINUE · 続きを読む" Style="{StaticResource TzKicker}" />
          <Grid>
            <ScrollView x:Name="ContinueScroller" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="-8,0,0,0">
              <StackPanel x:Name="ContinueRow" Orientation="Horizontal" Spacing="16" Padding="8,14,40,18" />
            </ScrollView>
            <Border HorizontalAlignment="Right" Width="96" IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="{ThemeResource TzContentLayerFade}" Offset="0" />
                  <GradientStop Color="{ThemeResource TzContentLayerColor}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Grid>
        </StackPanel>

        <Grid Margin="-4,18,-40,20">
          <ScrollView x:Name="ChipScroller" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="8" Padding="4,2,40,2" />
          </ScrollView>
          <Border HorizontalAlignment="Right" Width="72" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{ThemeResource TzContentLayerFade}" Offset="0" />
                <GradientStop Color="{ThemeResource TzContentLayerColor}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>

        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,70,0,0" MaxWidth="440" Spacing="10">
          <TextBlock Text="続" FontFamily="{StaticResource TzMinchoFont}" FontSize="120" Opacity="0.14" HorizontalAlignment="Center" Margin="0,0,0,-10" />
          <TextBlock x:Name="EmptyTitle" Text="Your shelf is empty" Style="{StaticResource TzTitle}" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyBody" Text="Pair your phone to bring your library over, or find something on MangaDex." Style="{StaticResource TzSecondary}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
          <StackPanel x:Name="EmptyActions" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button x:Name="EmptyPair" Style="{StaticResource TzAccentButton}" Content="Pair your phone" />
            <Button x:Name="EmptyBrowse" Style="{StaticResource TzSoftButton}" Content="Browse MangaDex" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </GridView.Header>
  </GridView>
</UserControl>
