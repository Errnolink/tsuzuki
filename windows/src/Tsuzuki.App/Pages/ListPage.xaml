<UserControl
    x:Class="Tsuzuki.App.Pages.ListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ListView x:Name="List" SelectionMode="None" Padding="40,74,40,48" MaxWidth="1100" HorizontalAlignment="Stretch" Margin="-12,8,-12,0">
    <ListView.Header>
      <StackPanel Margin="12,0,12,0">
        <TextBlock x:Name="Kicker" Style="{StaticResource TzKicker}" />
        <TextBlock x:Name="Heading" Style="{StaticResource TzLargeTitle}" Margin="0,2,0,0" />
        <TextBlock x:Name="Summary" Style="{StaticResource TzCaption}" Margin="0,4,0,0" />
      </StackPanel>
    </ListView.Header>
    <ListView.Footer>
      <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,80,0,0" Spacing="10" MaxWidth="420">
        <TextBlock x:Name="EmptyGlyph" FontFamily="{StaticResource TzMinchoFont}" FontSize="96" Opacity="0.14" HorizontalAlignment="Center" />
        <TextBlock x:Name="EmptyTitle" Style="{StaticResource TzTitle}" HorizontalAlignment="Center" />
        <TextBlock x:Name="EmptyBody" Style="{StaticResource TzSecondary}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
      </StackPanel>
    </ListView.Footer>
  </ListView>
</UserControl>
