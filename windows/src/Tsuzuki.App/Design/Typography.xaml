<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="TzBaseText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TzTextFont}" />
    <Setter Property="Foreground" Value="{ThemeResource TzText}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextLineBounds" Value="Full" />
  </Style>
  <Style x:Key="TzDisplay" TargetType="TextBlock" BasedOn="{StaticResource TzBaseText}">
    <Setter Property="FontFamily" Value="{StaticResource TzDisplayFont}" />
    <Setter Property="FontSize" Value="38" />
    <Setter Property="LineHeight" Value="46" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="-12" />
  </Style>
  <Style x:Key="TzLargeTitle" TargetType="TextBlock" BasedOn="{StaticResource TzBaseText}">
    <Setter Property="FontFamily" Value="{StaticResource TzDisplayFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="LineHeight" Value="38" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="-10" />
  </Style>
  <Style x:Key="TzTitle" TargetType="TextBlock" BasedOn="{StaticResource TzBaseText}">
    <Setter Property="FontFamily" Value="{StaticResource TzDisplayFont}" />
    <Setter Property="FontSize" Value="21" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="TzSubtitle" TargetType="TextBlock" BasedOn="{StaticResource TzBaseText}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="TzBody" TargetType="TextBlock" BasedOn="{StaticResource TzBaseText}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style x:Key="TzBodyStrong" TargetType="TextBlock" BasedOn="{StaticResource TzBody}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="TzSecondary" TargetType="TextBlock" BasedOn="{StaticResource TzBody}">
    <Setter Property="Foreground" Value="{ThemeResource TzTextSecondary}" />
  </Style>
  <Style x:Key="TzCaption" TargetType="TextBlock" BasedOn="{StaticResource TzBaseText}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{ThemeResource TzTextSecondary}" />
  </Style>
  <Style x:Key="TzKicker" TargetType="TextBlock" BasedOn="{StaticResource TzBaseText}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="120" />
    <Setter Property="Foreground" Value="{ThemeResource TzTextTertiary}" />
  </Style>
  <Style x:Key="TzIcon" TargetType="FontIcon">
    <Setter Property="FontFamily" Value="{StaticResource TzIconFont}" />
    <Setter Property="FontSize" Value="18" />
  </Style>
</ResourceDictionary>
