<Window
    x:Class="Tsuzuki.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tsuzuki">
  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt" />
  </Window.SystemBackdrop>
  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Grid.ColumnSpan="2" Height="48" Canvas.ZIndex="1" IsBackButtonVisible="False" BackRequested="OnTitleBarBack" />

    <Border x:Name="ContentLayer" Grid.Column="1" Grid.Row="1" CornerRadius="8,0,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
      <Grid>
        <Grid x:Name="PageHost" />
        <StackPanel x:Name="InfoBarHost" VerticalAlignment="Top" Margin="36,16,36,0" Spacing="8" />
      </Grid>
    </Border>

    <Grid x:Name="ReaderHost" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed" />
    <Grid x:Name="SheetHost" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed">
      <Border x:Name="SheetScrim" Background="{ThemeResource TzScrim}" />
      <Border x:Name="SheetCard" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720" Margin="40"
              CornerRadius="{StaticResource TzCardRadius}" Background="{ThemeResource TzElevated}" BorderBrush="{ThemeResource TzStrokeStrong}" BorderThickness="1" Padding="32,28" />
    </Grid>
    <Grid x:Name="PaletteHost" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed" />
    <StackPanel x:Name="ToastHost" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24" Spacing="10" />
  </Grid>
</Window>
