-- NOTE: must update MERGED_SOURCE_ID (6969) here
getRecentUpdates:
WITH RECURSIVE
combinations(manga_id, scanlator) AS (
    SELECT DISTINCT ES.manga_id, C.scanlator
    FROM excluded_scanlators ES CROSS JOIN chapters C
    ON C.manga_id = ES.manga_id
    WHERE C.scanlator IS NOT NULL AND C.scanlator != ''
    UNION
    SELECT DISTINCT M.merge_id AS manga_id, C.scanlator
    FROM excluded_scanlators ES CROSS JOIN merged M
    ON M.merge_id = ES.manga_id
    CROSS JOIN chapters C
    ON C.manga_id = M.manga_id
    WHERE C.scanlator IS NOT NULL AND C.scanlator != ''
),
credits(manga_id, scanlator, credit, remaining) AS (
    SELECT manga_id, scanlator, '', scanlator || ' & ' FROM combinations
    UNION ALL
    SELECT manga_id, scanlator,
        trim(substr(remaining, 1, instr(remaining, ' & ') - 1)),
        substr(remaining, instr(remaining, ' & ') + 3)
    FROM credits
    WHERE remaining != ''
),
excluded_scanlators_expanded(manga_id, scanlator) AS (
    SELECT C.manga_id, C.scanlator
    FROM credits C
    LEFT JOIN excluded_scanlators ES ON ES.manga_id = C.manga_id
        AND instr(' & ' || ES.scanlator || ' & ', ' & ' || C.credit || ' & ') > 0
    WHERE C.credit != ''
    GROUP BY C.manga_id, C.scanlator
    HAVING CASE WHEN (SELECT match_all FROM tsuzuki_chapter_filter WHERE _id = 1) = 1
        THEN min(CASE WHEN ES.scanlator IS NULL THEN 0 ELSE 1 END)
        ELSE max(CASE WHEN ES.scanlator IS NULL THEN 0 ELSE 1 END)
    END = 1
)
SELECT * FROM (
    SELECT
        mangas._id AS mangaId,
        mangas.title AS mangaTitle,
        chapters._id AS chapterId,
        chapters.name AS chapterName,
        chapters.scanlator AS scanlator,
        chapters.url AS chapterUrl,
        chapters.read AS read,
        chapters.bookmark AS bookmark,
        chapters.last_page_read AS last_page_read,
        mangas.source AS source,
        mangas.favorite AS favorite,
        mangas.thumbnail_url AS thumbnailUrl,
        mangas.cover_last_modified AS coverLastModified,
        chapters.date_upload AS dateUpload,
        chapters.date_fetch AS datefetch,
        excluded_scanlators.scanlator AS excludedScanlator
    FROM chapters
    CROSS JOIN mangas
    ON mangas._id = chapters.manga_id
    LEFT JOIN excluded_scanlators_expanded AS excluded_scanlators
    ON mangas._id = excluded_scanlators.manga_id
    AND chapters.scanlator = excluded_scanlators.scanlator
    WHERE mangas.favorite = 1 AND mangas.source <> 6969
    AND chapters.date_fetch > mangas.date_added
    AND chapters.date_upload > :after
    ORDER BY chapters.date_fetch DESC
    LIMIT :limit
)
UNION ALL
SELECT * FROM (
    SELECT
        mangas._id AS mangaId,
        mangas.title AS mangaTitle,
        chapters._id AS chapterId,
        chapters.name AS chapterName,
        chapters.scanlator AS scanlator,
        chapters.url AS chapterUrl,
        chapters.read AS read,
        chapters.bookmark AS bookmark,
        chapters.last_page_read AS last_page_read,
        mangas.source AS source,
        mangas.favorite AS favorite,
        mangas.thumbnail_url AS thumbnailUrl,
        mangas.cover_last_modified AS coverLastModified,
        chapters.date_upload AS dateUpload,
        chapters.date_fetch AS datefetch,
        excluded_scanlators.scanlator AS excludedScanlator
    FROM mangas
    LEFT JOIN (
        SELECT merged.manga_id,merged.merge_id
        FROM merged
        GROUP BY merged.merge_id
    ) AS ME
    ON ME.merge_id = mangas._id
    JOIN chapters
    ON ME.manga_id = chapters.manga_id
    LEFT JOIN excluded_scanlators_expanded AS excluded_scanlators
    ON mangas._id = excluded_scanlators.manga_id
    AND chapters.scanlator = excluded_scanlators.scanlator
    WHERE mangas.favorite = 1 AND mangas.source = 6969
    AND chapters.date_fetch > mangas.date_added
    AND chapters.date_upload > :after
    ORDER BY chapters.date_fetch DESC
    LIMIT :limit
)
ORDER BY datefetch DESC, chapterId DESC, mangaId DESC
LIMIT :limit;

getRecentUpdatesWithFilters:
WITH RECURSIVE
combinations(manga_id, scanlator) AS (
    SELECT DISTINCT ES.manga_id, C.scanlator
    FROM excluded_scanlators ES CROSS JOIN chapters C
    ON C.manga_id = ES.manga_id
    WHERE C.scanlator IS NOT NULL AND C.scanlator != ''
    UNION
    SELECT DISTINCT M.merge_id AS manga_id, C.scanlator
    FROM excluded_scanlators ES CROSS JOIN merged M
    ON M.merge_id = ES.manga_id
    CROSS JOIN chapters C
    ON C.manga_id = M.manga_id
    WHERE C.scanlator IS NOT NULL AND C.scanlator != ''
),
credits(manga_id, scanlator, credit, remaining) AS (
    SELECT manga_id, scanlator, '', scanlator || ' & ' FROM combinations
    UNION ALL
    SELECT manga_id, scanlator,
        trim(substr(remaining, 1, instr(remaining, ' & ') - 1)),
        substr(remaining, instr(remaining, ' & ') + 3)
    FROM credits
    WHERE remaining != ''
),
excluded_scanlators_expanded(manga_id, scanlator) AS (
    SELECT C.manga_id, C.scanlator
    FROM credits C
    LEFT JOIN excluded_scanlators ES ON ES.manga_id = C.manga_id
        AND instr(' & ' || ES.scanlator || ' & ', ' & ' || C.credit || ' & ') > 0
    WHERE C.credit != ''
    GROUP BY C.manga_id, C.scanlator
    HAVING CASE WHEN (SELECT match_all FROM tsuzuki_chapter_filter WHERE _id = 1) = 1
        THEN min(CASE WHEN ES.scanlator IS NULL THEN 0 ELSE 1 END)
        ELSE max(CASE WHEN ES.scanlator IS NULL THEN 0 ELSE 1 END)
    END = 1
)
SELECT * FROM (
    SELECT
        mangas._id AS mangaId,
        mangas.title AS mangaTitle,
        chapters._id AS chapterId,
        chapters.name AS chapterName,
        chapters.scanlator AS scanlator,
        chapters.url AS chapterUrl,
        chapters.read AS read,
        chapters.bookmark AS bookmark,
        chapters.last_page_read AS last_page_read,
        mangas.source AS source,
        mangas.favorite AS favorite,
        mangas.thumbnail_url AS thumbnailUrl,
        mangas.cover_last_modified AS coverLastModified,
        chapters.date_upload AS dateUpload,
        chapters.date_fetch AS datefetch,
        excluded_scanlators.scanlator AS excludedScanlator
    FROM chapters
    CROSS JOIN mangas
    ON mangas._id = chapters.manga_id
    LEFT JOIN excluded_scanlators_expanded AS excluded_scanlators
    ON mangas._id = excluded_scanlators.manga_id
    AND chapters.scanlator = excluded_scanlators.scanlator
    WHERE mangas.favorite = 1 AND mangas.source <> 6969
    AND chapters.date_fetch > mangas.date_added
    AND chapters.date_upload > :after
    AND (:read IS NULL OR chapters.read = :read)
    AND (
        :started IS NULL
        OR (:started = 1 AND chapters.last_page_read > 0 AND chapters.read = 0)
        OR (:started = 0 AND chapters.last_page_read = 0 AND chapters.read = 0)
    )
    AND (:bookmarked IS NULL OR chapters.bookmark = :bookmarked)
    AND (
        (excluded_scanlators.scanlator IS NULL OR :hideExcludedScanlators = 0)
    )
    ORDER BY chapters.date_fetch DESC
    LIMIT :limit
)
UNION ALL
SELECT * FROM (
    SELECT
        mangas._id AS mangaId,
        mangas.title AS mangaTitle,
        chapters._id AS chapterId,
        chapters.name AS chapterName,
        chapters.scanlator AS scanlator,
        chapters.url AS chapterUrl,
        chapters.read AS read,
        chapters.bookmark AS bookmark,
        chapters.last_page_read AS last_page_read,
        mangas.source AS source,
        mangas.favorite AS favorite,
        mangas.thumbnail_url AS thumbnailUrl,
        mangas.cover_last_modified AS coverLastModified,
        chapters.date_upload AS dateUpload,
        chapters.date_fetch AS datefetch,
        excluded_scanlators.scanlator AS excludedScanlator
    FROM mangas
    LEFT JOIN (
        SELECT merged.manga_id,merged.merge_id
        FROM merged
        GROUP BY merged.merge_id
    ) AS ME
    ON ME.merge_id = mangas._id
    JOIN chapters
    ON ME.manga_id = chapters.manga_id
    LEFT JOIN excluded_scanlators_expanded AS excluded_scanlators
    ON mangas._id = excluded_scanlators.manga_id
    AND chapters.scanlator = excluded_scanlators.scanlator
    WHERE mangas.favorite = 1 AND mangas.source = 6969
    AND chapters.date_fetch > mangas.date_added
    AND chapters.date_upload > :after
    AND (:read IS NULL OR chapters.read = :read)
    AND (
        :started IS NULL
        OR (:started = 1 AND chapters.last_page_read > 0 AND chapters.read = 0)
        OR (:started = 0 AND chapters.last_page_read = 0 AND chapters.read = 0)
    )
    AND (:bookmarked IS NULL OR chapters.bookmark = :bookmarked)
    AND (
        (excluded_scanlators.scanlator IS NULL OR :hideExcludedScanlators = 0)
    )
    ORDER BY chapters.date_fetch DESC
    LIMIT :limit
)
ORDER BY datefetch DESC, chapterId DESC, mangaId DESC
LIMIT :limit;

